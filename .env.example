# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Development Database (for testing)
MONGODB_URI_DEV=mongodb+srv://username:password@cluster.mongodb.net/sparkle-dev?retryWrites=true&w=majority&appName=Cluster0

# Production Database
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/sparkle-prod?retryWrites=true&w=majority&appName=Cluster0

# Active MongoDB URI (fallback)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sparkle-dev?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_EXPIRES_IN=1h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email Configuration (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
CONTACT_EMAIL_TO=contact@sparkle.com
